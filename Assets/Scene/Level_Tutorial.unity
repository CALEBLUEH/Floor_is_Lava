  tileGrid: {fileID: 2005313552}
  player: {fileID: 756321359}
  ghostPrefab: {fileID: 4403311219196195099, guid: 00033e7a3d977a24ea2a73f11d6a0c35, type: 3}
  completionUi: {fileID: 0}
  noSignalDuration: 0.28
  dialogueDuration: 3.1
  emojiInterval: 1.25
  symbolDisplayDuration: 2.2
  completionPanelDelay: 2.2
  ghostMoveSpeed: 3.5
  trailWarningDuration: 0.8
  trailHazardDuration: 1.6
  stagePause: 1
  interactionPrompt: Use mouse to interact...
  introductionLines:
  - (O v O)
  - Welcome to Floor is Lava, I'm your guide!
  - This is a very simple game! We'll first start with basic movement!
  - Use WASD to move, Space to jump, and hold Shift to move faster!
  objectiveInstruction: Try to step on this green tile!
  colourIntroductionLines:
  - Good job!
  - Everything is determined by colour, even when its appearance changes.
  - Green is your objective. Touch or step on every green tile!
  redInstruction: Red means danger. Touching it reduces your health, so avoid anything
    red!
  yellowInstruction: Yellow is a warning before danger appears. Move away before
    it turns red!
  challengeInstruction: Collect every green tile. Red ghosts move one grid step at
    a time, and your trail becomes dangerous!
  completionLines:
  - Good job! You've learned the basics of the game!
  - You can interact with me, so the mouse may also be used during the game!
  - Interactions can vary, so I'll let you discover the rest yourself!
  emojiFaces:
  - (O v O)
  - (^ o ^)
  - (> w <)
  - (T _ T)
  - (> _ <)
  - (- . -)
  - (O _ O)
  - (x _ x)
